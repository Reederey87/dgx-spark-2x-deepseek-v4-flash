# SPDX-License-Identifier: Apache-2.0
ARG VLLM_BASE=vllm-dspark-runtime:v0261-main-c8r
ARG VLLM_PKG_DIR=/usr/local/lib/python3.12/dist-packages/vllm
FROM ${VLLM_BASE}
ARG VLLM_PKG_DIR
LABEL org.opencontainers.image.source="https://github.com/Reederey87/dgx-spark-2x-deepseek-v4-flash"
LABEL org.opencontainers.image.description="c8r plus thinking_token_budget default-sampling fast-path fix"
COPY apply-thinking-budget-fix.py /tmp/apply-thinking-budget-fix.py
RUN python3 /tmp/apply-thinking-budget-fix.py \
      "${VLLM_PKG_DIR}/v1/worker/gpu/sample/sampler.py" && \
    python3 -m py_compile \
      "${VLLM_PKG_DIR}/v1/worker/gpu/sample/sampler.py" && \
    grep -q 'Thinking budgets force the reasoning-end marker' \
      "${VLLM_PKG_DIR}/v1/worker/gpu/sample/sampler.py" && \
    rm /tmp/apply-thinking-budget-fix.py
