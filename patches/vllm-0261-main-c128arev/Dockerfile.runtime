# SPDX-License-Identifier: Apache-2.0
# Lane B (#51318 revert of #50004 adaptive C128A metadata packing), stacked on -ixfix.
ARG VLLM_BASE=vllm-dspark-runtime:v0261-main-c8r-tbfix-ixfix
ARG VLLM_PKG_DIR=/usr/local/lib/python3.12/dist-packages/vllm
FROM ${VLLM_BASE}
ARG VLLM_PKG_DIR
LABEL org.opencontainers.image.source="https://github.com/Reederey87/dgx-spark-2x-deepseek-v4-flash"
LABEL org.opencontainers.image.description="revert #50004 adaptive C128A metadata packing (#52448 stale-stride top-k corruption)"
COPY sparse_mla.py ${VLLM_PKG_DIR}/models/deepseek_v4/sparse_mla.py
RUN python3 -m py_compile ${VLLM_PKG_DIR}/models/deepseek_v4/sparse_mla.py && \
    ! grep -q 'active_topk_width' ${VLLM_PKG_DIR}/models/deepseek_v4/sparse_mla.py && \
    grep -q 'global_decode_buffer.stride(0)' ${VLLM_PKG_DIR}/models/deepseek_v4/sparse_mla.py
