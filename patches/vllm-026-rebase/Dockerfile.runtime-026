# SPDX-License-Identifier: Apache-2.0
# Runtime layer for the vLLM 0.26.0 gx10-overlay lane (the cand7 production image).
# Base: official linux/arm64 vllm/vllm-openai:v0.26.0 — supplies every 0.26 dependency
# (flashinfer-python 0.6.14 + cubin, cutlass-dsl 4.6.0, quack>=0.4.0, tokenspeed-mla
# 0.1.8, tilelang 0.1.9, torch 2.11.0). Its TORCH_CUDA_ARCH_LIST includes 12.0, which is
# family-compatible with GB10 sm_121a; 'a'-suffix kernels only matter for tcgen05 paths
# that family-120 gating disables anyway. This layer adds the patched overlay tree
# (materialized from the base by build-patched-image.sh) plus the two git pins.
ARG VLLM_BASE=vllm/vllm-openai:v0.26.0@sha256:ffb2d59b1c059a5bd8d781320c9f5189de8293693b7d95da54befddaa54abf52
ARG VLLM_PKG_DIR=/usr/local/lib/python3.12/dist-packages/vllm
ARG FLASHINFER_COMMIT=0472b9b3f2fba11b463f8526f390297d52a8aad7
ARG B12X_COMMIT=7dc6fb8fcc6446ea093537d1657df81985fa5f43

FROM ${VLLM_BASE}

ARG VLLM_PKG_DIR
ARG FLASHINFER_COMMIT
ARG B12X_COMMIT

LABEL org.opencontainers.image.source="https://github.com/Reederey87/dgx-spark-2x-deepseek-v4-flash"
LABEL org.opencontainers.image.description="vLLM 0.26.0 + gx10 GB10 overlay (cand7 lane)"

# Do NOT re-pin apache-tvm-ffi / cuda-python — inherit the base image's (tvm-ffi 0.1.10).
# Pinning 0.1.9 breaks cutlass-dsl 4.6.0's tvm_ffi_provider at first dummy run
# (TypeError: make_kwargs_wrapper() got an unexpected keyword argument
# 'map_dataclass_to_tuple').
ENV FLASHINFER_DISABLE_VERSION_CHECK=1
COPY .overlay-build-vllm/ ${VLLM_PKG_DIR}/
RUN python3 -m pip install --no-cache-dir --no-deps --no-build-isolation \
      "https://github.com/lukealonso/b12x/archive/${B12X_COMMIT}.tar.gz" && \
    python3 -m pip install --no-cache-dir --no-deps --no-build-isolation \
      --force-reinstall \
      "https://github.com/flashinfer-ai/flashinfer/archive/${FLASHINFER_COMMIT}.tar.gz"

ENTRYPOINT ["vllm", "serve"]
