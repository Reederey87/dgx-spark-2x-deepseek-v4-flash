# SPDX-License-Identifier: Apache-2.0
ARG VLLM_BASE=vllm-dspark-runtime:v0261-main-c8r-tbfix
ARG VLLM_PKG_DIR=/usr/local/lib/python3.12/dist-packages/vllm
FROM ${VLLM_BASE}
ARG VLLM_PKG_DIR
LABEL org.opencontainers.image.source="https://github.com/Reederey87/dgx-spark-2x-deepseek-v4-flash"
LABEL org.opencontainers.image.description="c8r-tbfix + PR #52492 keep indexer scoring in breakable graphs"
COPY attention.py ${VLLM_PKG_DIR}/models/deepseek_v4/attention.py
RUN python3 -m py_compile ${VLLM_PKG_DIR}/models/deepseek_v4/attention.py && \
    grep -q 'is_current_stream_capturing' ${VLLM_PKG_DIR}/models/deepseek_v4/attention.py
