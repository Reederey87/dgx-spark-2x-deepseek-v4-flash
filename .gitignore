# Your site-specific config — copy runtime/cluster.env.example to runtime/cluster.env.
# (Pattern has no leading slash, so it matches runtime/cluster.env too.)
cluster.env

# Rendered per-node compose env (generated by render-env.sh; contains host IPs).
.env.dspark

# Optional Telegram alert credentials for metrics-watch — copy from notify.env.example.
notify.env

# Any other secrets-bearing env file (belt and braces — the *.example templates end
# in .example and stay committable).
.env
*.env

# Transient build context of patches/vllm-026-rebase/build-patched-image.sh (a full
# extracted+patched vLLM tree — must never be committed; NOTICE policy).
.overlay-build-vllm

# Runtime state written on the head node by metrics-watch / warmup.
.metrics-watch*
logs/

# SSH keys / public keys — never commit.
*.key
*.pub
id_ed25519*
nvsync*

# Benchmark + run logs.
*.log
nccl-bench-*
/tmp/
runtime/.xid-test-*

# OS / editor cruft.
.DS_Store
*.swp
*~
